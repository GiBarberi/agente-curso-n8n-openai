    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Envía un CORREO FORMAL por Gmail a una persona de afuera del estudio: un cliente, un posible cliente o un proveedor. Usala cuando el usuario pida \"mandale un mail\", \"escribile a\", \"enviá una propuesta o un presupuesto\" o cuando haya que dejar algo por escrito con alguien externo. Necesita el email del destinatario: si el usuario no lo dio, NO la uses y pedíselo. No la uses para avisos internos al equipo (para eso está Slack).",
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('destinatario', 'Email del destinatario externo (cliente o proveedor), tal como lo escribió el usuario') }}",
        "subject": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('asunto', 'Asunto breve y profesional del correo') }}",
        "emailType": "text",
        "message": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('mensaje', 'Cuerpo del correo en tono formal y cordial, firmado como \"Bera, asistente de Gi Barberi\"') }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "5a4b255f-3cd3-4ba7-bc94-26ef6bc1b1a1",
      "name": "Enviar correo formal (Gmail)",
