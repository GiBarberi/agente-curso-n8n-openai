    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Publica un AVISO RÁPIDO para el EQUIPO INTERNO del estudio en el canal de Slack #agente-bera. Usala cuando el usuario pida \"avisale al equipo\", \"contale a los chicos\", \"dejá un aviso\" o cuando haya una novedad interna: cambios de horario de reuniones, tareas o recordatorios. Mensajes cortos e informales. No la uses para escribirle a clientes ni a personas de afuera (para eso está Gmail). Las urgencias las avisa el flujo automáticamente: no hace falta que las publiques vos.",
        "authentication": "oAuth2",
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "agente-bera"
        },
        "messageType": "text",
        "text": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('aviso', 'Texto del aviso para el equipo: corto, claro y directo') }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "id": "aa59d3cc-f106-4332-b0ad-8712097cb941",
      "name": "Avisar al equipo (Slack)",
      "type": "n8n-nodes-base.slackTool",
      "typeVersion": 2.7,
