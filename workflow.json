    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Calcula la tasa de errores y el consumo de la última hora\nconst hace1h = Date.now() - 60 * 60 * 1000;\nconst filas = $input.all().map((i) => i.json).filter((r) => r && r.createdAt && new Date(r.createdAt).getTime() >= hace1h);\nconst total = filas.length;\nconst errores = filas.filter((r) => Number(r.http_status) >= 500 || String(r.resultado).startsWith('error')).length;\nconst tokens = filas.reduce((s, r) => s + (Number(r.tokens_estimados) || 0), 0);\nconst tasa = total ? errores / total : 0;\nreturn [{ json: { total, errores, tasa_errores: Math.round(tasa * 100), tokens_ultima_hora: tokens, alertar: (total >= 5 && tasa > 0.2) || tokens > 20000 } }];\n"
      },
      "id": "d3c99835-d1fe-436f-bad3-90e9b72bdcbd",
      "name": "Calcular tasa de errores y tokens",
